# Copy this file to `.env` and fill in your own secret keys. DO NOT commit `.env`.
# Example values are placeholders only.

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (alternativa com múltiplos modelos)
# Use "auto" para melhor modelo gratuito (qwen-2.5-72b)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto

# Hyperbolic AI
HYPERBOLIC_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Default provider: "gemini", "openai", "openrouter", "hyperbolic", "anthropic", "ollama"
AI_PROVIDER=gemini

# Optional runtime settings
GRADIO_SERVER_PORT=7860
